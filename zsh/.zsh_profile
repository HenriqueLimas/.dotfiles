VIM="nvim"
export GIT_EDITOR=$VIM

alias vim="node -v > /dev/null; nvim"
alias vi="node -v > /dev/null; nvim"

# GIT
alias g="git"
alias gad="git add"
alias gcm="git commit -m"
alias gcmappend="git commit --amend --no-edit"
alias gco="git checkout"
alias gcb="git checkout -b"
alias gdf="git diff"
alias gst="git status"
alias gsh="git stash"
alias gsa="git stash apply"
alias gfh="git fetch"
alias gp='git pull'
alias gpl='gp origin `gcurrentbranch`'
alias gph="git push origin head"
alias gundo="git reset --soft HEAD^"
alias gcount="git shortlog -sn"
alias gcurrentbranch="git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/\1/'"
alias gwa="git worktree add"
alias gwl="git worktree list"
alias gwr="git worktree remove"

alias ..="cd .."
alias ...="cd ../.."

alias chrome='open -a Google\ Chrome --args'

alias kp="kill -9 $(lsof -i :8443 -t)"

alias sshgithub="ssh-add --apple-use-keychain ~/.ssh/id_ed_public_github"
bindkey -s '^f' "tmux-agent-pane\n"

export PATH="$HOME/.yarn/bin:$PATH"
export PATH="/Users/hlimas/Library/Python/2.7/bin/:$PATH"
export PATH="/usr/local/lib/ruby/gems/2.5.0/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

export GOPATH="$HOME/go"
export PATH="$PATH:/usr/local/go/bin:$GOPATH/bin"

# pnpm
export PNPM_HOME="/Users/hlimas/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

. "$HOME/.cargo/env"
eval $(/opt/homebrew/bin/brew shellenv)

# fnm (must come after brew so fnm's node takes precedence)
eval "$(fnm env --use-on-cd --shell zsh)"
alias nvm="fnm"

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=(/Users/hlimas/.docker/completions $fpath)
autoload -Uz compinit
compinit
# End of Docker CLI completions
