{
  "providers": {
    "ebay": {
      "api": "anthropic-messages",
      "apiKey": "!cat ~/.ebay-claude-code.txt 2>/dev/null || npx -y --registry=https://npm.corp.ebay.com @ebay/claude-code-token get_token",
      "authHeader": true,
      "baseUrl": "https://platformgateway2.vip.ebay.com/hubgptgatewaysvc/v1/anthropic",
      "models": [
        {
          "id": "claude-sonnet-4-6",
          "contextWindow": 200000,
          "reasoning": true,
          "thinkingLevelMap": {
            "xhigh": "max"
          }
        }
      ]
    },
    "ollama": {
      "api": "openai-completions",
      "apiKey": "ollama",
      "baseUrl": "http://localhost:11434/v1",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": true
      },
      "models": [
        {
          "id": "qwen3.8:27b",
          "name": "Qwen 3.8 27B (Local)",
          "contextWindow": 128000,
          "input": ["text", "image"],
          "maxTokens": 16384,
          "reasoning": true
        }
      ]
    }
  }
}
